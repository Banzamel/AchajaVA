{
  "language": "polish",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_DIR__/.venv/Scripts/python.exe",
            "args": ["-m", "achaja.hooks.gate"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__home-assistant__.*",
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_DIR__/.venv/Scripts/python.exe",
            "args": ["-m", "achaja.hooks.home_guard"],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_DIR__/.venv/Scripts/python.exe",
            "args": ["-m", "achaja.hooks.event"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_DIR__/.venv/Scripts/python.exe",
            "args": ["-m", "achaja.hooks.stop"],
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PROJECT_DIR__/.venv/Scripts/python.exe",
            "args": ["-m", "achaja.hooks.event"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
